TIME_ZONE=UTC

LOGGER_LEVEL=debug
LOGGER_FOLDER=./logs

JWT_SECRET=change-me-32-bytes-minimum
JWT_DURATION=24h

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=30s
GROQ_MAX_RETRIES=2

TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_TIMEOUT=20s

NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=finance-ai-service/1.0 (contact@example.com)
NOMINATIM_TIMEOUT=10s

OSRM_URL=http://router.project-osrm.org
OSRM_TIMEOUT=15s

FUEL_CONSUMPTION_L_PER_100KM=8.0
FUEL_PRICE_PER_LITER=55.0
TAXI_PRICE_PER_KM=30.0
TRAVEL_COST_MODE=fuel

AI_GRPC_PORT=50056
AI_METRICS_PORT=9099

TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_CA_FILE=

REDIS_ADDR=finance-redis:6379
CACHE_TTL=10m

POSTGRES_HOST=ai-postgres
POSTGRES_PORT=5432
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=ai_pass
POSTGRES_DB=ai_db
POSTGRES_TIMEOUT=10s